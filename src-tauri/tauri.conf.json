{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voice Chat",
  "version": "../package.json",
  "identifier": "com.finterigion.voice-chat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:2475",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Voice Chat",
        "width": 1000,
        "height": 700,
        "minWidth": 720,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: avatar: http://avatar.localhost; media-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "FINTERIGION",
    "copyright": "Copyright © 2026 Yuchao Feng",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/FINTERIGION/voice-chat",
    "shortDescription": "Real-time voice chat with AI characters",
    "longDescription": "A desktop app for hands-free voice conversations with customizable AI characters, powered by Alibaba Cloud Model Studio realtime audio.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4QjFEQkE1NUE2RTEzRjAKUldUd0UyNWFwZHV4T0dpeTRiSGZITndtbDdZVHBaZmMvdVBJK3I4TmRVWVZtdGI4ZzQwMlpBelUK",
      "endpoints": [
        "https://github.com/FINTERIGION/voice-chat/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
