{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoiceChat",
  "version": "../package.json",
  "identifier": "com.voicechat.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Voice Chat",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "FINTERIGION",
    "copyright": "Copyright © 2026 Yuchao Feng",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/FINTERIGION/VoiceChat",
    "shortDescription": "Real-time voice chat with AI characters",
    "longDescription": "A desktop app for hands-free voice conversations with customizable AI characters, powered by Alibaba Cloud Model Studio realtime audio.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
